{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "types": ["node"],
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "dist-electron",
    "declaration": false,
    "removeComments": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts", "engine/**/*.ts", "hosts/**/*.ts"]
}
