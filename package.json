{
  "name": "ding-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Ding Harness —— 本机优先的桌面 Agent 工作台（内核 + GUI/CLI 双宿主）",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "electron:build": "tsc -p tsconfig.electron.json && node scripts/mark-electron-cjs.mjs",
    "build": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:web && pnpm electron:build && electron-builder --win nsis && node scripts/verify-artifacts.mjs && node scripts/verify-packaged.mjs && node scripts/verify-acceptances.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "verify:accept": "node scripts/verify-acceptances.mjs",
    "lint": "oxlint",
    "ding": "tsx hosts/cli/ding.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.67",
    "ai": "7.0.137",
    "docx": "9.10.0",
    "exceljs": "4.4.0",
    "pptxgenjs": "4.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.12.0",
    "@xyflow/system": "0.0.83",
    "dompurify": "3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "highlight.js": "11.12.0",
    "jsdom": "30.1.2",
    "lucide-react": "1.55.0",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "mermaid": "12.1.0",
    "oxlint": "1.87.0",
    "pangu": "^7.2.0",
    "playwright": "^1.56.0",
    "prismjs": "1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "6.2.4",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.0.3",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.dingharness.app",
    "productName": "Ding Harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.map"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.cjs"
    },
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ding-harness-${version}-setup.${ext}"
    }
  }
}
