{
  "name": "ding-harness",
  "version": "0.5.0",
  "private": true,
  "description": "Ding Harness —— 本机优先的桌面 Agent 工作台（内核 + GUI/CLI 双宿主）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "build": "pnpm typecheck && pnpm lint && pnpm test && pnpm verify:drive-paths && pnpm build:web && pnpm electron:build && pnpm cli:build && pnpm package:win && node scripts/verify-artifacts.mjs && node scripts/verify-packaged.mjs && node scripts/verify-cli-npm.mjs && node scripts/verify-acceptances.mjs",
    "build:web": "vite build",
    "cli:build": "node scripts/build-cli.mjs",
    "dev:web": "vite",
    "ding": "tsx hosts/cli/ding.ts",
    "electron:build": "tsc -p tsconfig.electron.json && node scripts/mark-electron-cjs.mjs",
    "lint": "oxlint",
    "package:win": "node scripts/stage-app.mjs && electron-builder --win nsis",
    "poc:sdk": "tsx scripts/poc-sdk.mjs",
    "test": "vitest run",
    "verify:drive-paths": "tsx scripts/verify-drive-paths.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vendor:models": "node scripts/vendor-models.mjs",
    "verify:accept": "node scripts/verify-acceptances.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "perf:budget": "tsx scripts/perf-budget.ts",
    "eval": "tsx hosts/cli/ding.ts eval",
    "eval:samples": "tsx scripts/eval-samples.ts",
    "eval:matrix": "tsx scripts/eval-matrix.ts",
    "cli:bin": "node scripts/build-cli-bin.mjs",
    "cli:release": "pnpm cli:bin && node scripts/verify-cli-bin.mjs",
    "verify:cli-npm": "node scripts/verify-cli-npm.mjs",
    "prepack": "pnpm cli:build && node scripts/verify-cli-npm.mjs",
    "sandbox:build": "cargo build --release --manifest-path sandbox/Cargo.toml",
    "sandbox:probe": "cargo run --release --manifest-path sandbox/Cargo.toml -- --probe",
    "package:mac": "node scripts/stage-app.mjs && electron-builder --mac dmg",
    "package:linux": "node scripts/stage-app.mjs && electron-builder --linux AppImage deb",
    "verify:remote": "tsx scripts/verify-remote.ts",
    "verify:team": "tsx scripts/verify-team.ts",
    "longtask:real": "tsx scripts/longtask-real.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ],
    "overrides": {
      "pptxgenjs>image-size": "-"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/google": "^4.0.95",
    "@ai-sdk/openai-compatible": "3.0.67",
    "ai": "7.0.137",
    "docx": "9.10.0",
    "exceljs": "4.4.0",
    "pptxgenjs": "4.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.12.0",
    "@xyflow/system": "0.0.83",
    "dompurify": "3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "highlight.js": "11.12.0",
    "jsdom": "30.1.2",
    "lucide-react": "1.55.0",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "mermaid": "12.1.0",
    "oxlint": "1.87.0",
    "pangu": "^7.2.0",
    "playwright": "^1.56.0",
    "prismjs": "1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "6.2.4",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.0.3",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.dingharness.app",
    "productName": "Ding Harness",
    "directories": {
      "output": "release",
      "app": "release/app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.cjs"
    },
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ding-harness-${version}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "sandbox/target/release/ding-sandbox.exe",
        "to": "ding-sandbox.exe"
      }
    ]
  },
  "bin": {
    "ding": "dist-cli/hosts/cli/ding.js"
  },
  "files": [
    "dist-cli/**/*",
    "dist/**/*",
    "dist-electron/**/*",
    "README.md",
    "LICENSE"
  ]
}
