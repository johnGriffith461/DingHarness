{
  "name": "doubao-work-clone",
  "version": "0.1.0",
  "private": true,
  "description": "AI 工作台 + 无限画布（对标豆包工作 2.32.1 ai-views 形态与核心机制）",
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "electron:build": "tsc -p tsconfig.electron.json && node scripts/mark-electron-cjs.mjs",
    "build": "pnpm typecheck && pnpm test && pnpm build:web && pnpm electron:build && electron-builder --win nsis && node scripts/verify-artifacts.mjs && node scripts/verify-packaged.mjs && node scripts/verify-acceptances.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "verify:accept": "node scripts/verify-acceptances.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "*",
    "ai": "*",
    "docx": "*",
    "exceljs": "*",
    "pptxgenjs": "*",
    "readable-stream": "^2.3.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/prismjs": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.12.0",
    "@xyflow/system": "*",
    "dompurify": "*",
    "electron": "^44.7.0",
    "electron-builder": "*",
    "hammerjs": "*",
    "highlight.js": "*",
    "jsdom": "*",
    "lucide-react": "*",
    "markmap-lib": "*",
    "markmap-view": "*",
    "mermaid": "*",
    "pangu": "^7.2.0",
    "playwright": "^1.56.0",
    "prismjs": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "*",
    "tsx": "*",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "*",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.doubaoworkclone.app",
    "productName": "工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.map"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.cjs"
    },
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  }
}
